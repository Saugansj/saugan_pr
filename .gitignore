# ---- secrets (never commit) ----
.env
.env.*
*.key
*.pem
*.p12
.roster_human_key
**/.roster_human_key

# ---- virtual environments ----
.venv/
.venv-claim/
**/.venv/
**/.venv-claim/
**/site-packages/
**/node_modules/

# ---- runtime data and ledgers (GBs, regenerated by the runs) ----
roster/data/
roster/trader/live/live.json
roster/trader/live/live_b.json
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.jsonl

# ---- heavy research artifacts (parquet data, compiled extensions) ----
**/*.parquet
**/*.pyd
**/*.dll
**/*.lib
**/*.so
roster/research/measure/
roster/research/spike/

# ---- caches ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- local backups ----
backup_before_*/

# ---- generated audit / research outputs ----
**/audit-tmp/
roster/research/competitors/out/
